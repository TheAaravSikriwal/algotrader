# Copy this file to ".env" and fill it in. Keep .env out of version control --
# these are credentials. (.gitignore already excludes it.)

# ---------------------------------------------------------------------------
# PAPER KEYS -- fake money. Everything in this project runs on these.
# Alpaca dashboard -> switch to "Paper" -> API Keys -> Generate
# ---------------------------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ---------------------------------------------------------------------------
# LIVE KEYS -- real money. Leave these BLANK until a strategy has earned them.
# Alpaca dashboard -> switch to "Live" -> API Keys -> Generate
#
# These are separate variables on purpose. Paper and live issue different
# credentials, and keeping them apart means a paper run cannot reach your real
# account even if you fumble a command-line flag. While these stay empty, live
# mode physically cannot start.
# ---------------------------------------------------------------------------
ALPACA_LIVE_API_KEY_ID=
ALPACA_LIVE_API_SECRET_KEY=
